{
  "$defs": {
    "Column": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "reasons": {
          "items": {
            "$ref": "#/$defs/ReviewReason"
          },
          "title": "Reasons",
          "type": "array"
        },
        "metrics": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Metrics",
          "type": "object"
        },
        "base_level": {
          "title": "Base Level",
          "type": "string"
        },
        "top_level": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top Level"
        },
        "center": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Center",
          "type": "array"
        },
        "shape": {
          "enum": [
            "rect",
            "circle"
          ],
          "title": "Shape",
          "type": "string"
        },
        "size": {
          "items": {
            "exclusiveMinimum": 0.0,
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Size",
          "type": "array"
        },
        "rotation_deg": {
          "default": 0.0,
          "title": "Rotation Deg",
          "type": "number"
        },
        "embedded_in": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Embedded In"
        }
      },
      "required": [
        "id",
        "confidence",
        "status",
        "base_level",
        "center",
        "shape",
        "size"
      ],
      "title": "Column",
      "type": "object"
    },
    "GeneratorInfo": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "default": "scan2bim",
