        "seed": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Seed",
          "type": "array"
        },
        "area": {
          "minimum": 0.0,
          "title": "Area",
          "type": "number"
