                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Metrics",
          "type": "object"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "elevation": {
          "title": "Elevation",
          "type": "number"
        }
      },
      "required": [
        "id",
        "confidence",
        "status",
        "name",
        "elevation"
      ],
      "title": "Level",
      "type": "object"
    },
    "Offset": {
      "additionalProperties": false,
