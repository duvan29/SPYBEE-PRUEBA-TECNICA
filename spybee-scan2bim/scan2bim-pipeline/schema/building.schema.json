        "one_face",
        "low_coverage",
        "high_residual",
        "vertical_discontinuity",
        "thickness_out_of_catalog",
        "non_orthogonal",
        "occlusion_partial",
        "embedded",
        "thickness_default",
        "clutter",
        "level_merged"
      ],
      "title": "ReviewReason",
      "type": "string"
    },
    "Slab": {
      "additionalProperties": false,
